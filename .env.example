# Copy to .env and fill in real values. Never commit .env.

# --- OpenAI (required) ---
OPENAI_API_KEY=
SMARTDESK_LLM_MODEL=gpt-4o-mini
SMARTDESK_EMBEDDING_MODEL=text-embedding-3-small
SMARTDESK_LLM_TEMPERATURE=0
SMARTDESK_LLM_TIMEOUT_SECONDS=30
SMARTDESK_LLM_MAX_RETRIES=2

# --- Langfuse (optional; tracing is disabled when keys are blank) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Knowledge base and RAG (optional) ---
SMARTDESK_KB_DIR=data/kb
SMARTDESK_CHROMA_DIR=data/chroma
SMARTDESK_CHROMA_COLLECTION=smartdesk_kb
SMARTDESK_RAG_TOP_K=5
SMARTDESK_RAG_MIN_SIMILARITY=0.35

# --- Jira Cloud (used from Milestone 4) ---
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
