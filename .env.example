# Copy to .env and fill in real values. Never commit .env.

# --- OpenAI (required) ---
OPENAI_API_KEY=
SMARTDESK_LLM_MODEL=gpt-4o-mini
SMARTDESK_EMBEDDING_MODEL=text-embedding-3-small
SMARTDESK_LLM_TEMPERATURE=0
SMARTDESK_LLM_TIMEOUT_SECONDS=30
SMARTDESK_LLM_MAX_RETRIES=2

# --- Langfuse (optional; tracing is disabled when keys are blank) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
