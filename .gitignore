# Secrets (any .env variant, e.g. .env.txt; only the template is tracked)
.env*
!.env.example

# Confidential course material
docs/*.pdf

# Submission archive (built with git archive)
smartdesk-ai.zip

# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# Chainlit runtime files (.chainlit/config.toml is tracked)
.files/
.chainlit/translations/

# Local data stores
chroma/
*.db
*.db-wal
*.db-shm
data/raw/

# M7 evaluation: response caches and per-run logs stay local (RUN.json and the report are committed)
data/eval/.cache/
data/eval/runs/
